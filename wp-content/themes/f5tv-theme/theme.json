        "typography": {
          "fontWeight": "var(--wp--preset--font-weight--semibold)"
        },
        "border": {
          "radius": "var(--wp--preset--border--radius--md)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--3)",
            "right": "var(--wp--preset--spacing--6)",
            "bottom": "var(--wp--preset--spacing--3)",
            "left": "var(--wp--preset--spacing--6)"
          }
        },
        "__experimental": {
          "style": {
            "variations": {
              "primary": {
                "color": {
                  "background": "var(--wp--preset--color--f5-red)",
                  "text": "var(--wp--preset--color--white)"
                }
              },
              "secondary": {
                "color": {
                  "background": "var(--wp--preset--color--f5-card)",
                  "text": "var(--wp--preset--color--zinc-100)"
                },
                "border": {
                  "color": "var(--wp--preset--color--zinc-700)",
                  "width": "var(--wp--preset--border--width--thin)"
                }
              },
              "outline": {
                "color": {
                  "background": "transparent",
                  "text": "var(--wp--preset--color--f5-red)"
                },
                "border": {
                  "color": "var(--wp--preset--color--f5-red)",
                  "width": "var(--wp--preset--border--width--thin)"
                }
              }
            }
          }
        }
      },
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "var(--wp--preset--font-weight--bold)"
        }
      },
      "core/cover": {
        "color": {
          "overlay": "var(--wp--preset--color--f5-blue)"
        }
      },
      "core/group": {
        "color": {
          "background": "var(--wp--preset--color--f5-card)"
        }
      }
